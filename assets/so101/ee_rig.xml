<mujoco model="ee_rig">
  <!-- 2026-09-23: 로봇 몸통(5관절 체인) 없이 EE(도구 끝)만 시뮬레이션한다 — 시뮬레이션에서는 리더의
       EE(또는 조이스틱 명령)만 참고하면 되고, 관절 구속/캘리브레이션은 신경 쓸 필요 없다는 결정.

       구조: mocap_target(kinematic, 매 스텝 Python에서 data.mocap_pos/quat로 직접 위치 지정 —
       조이스틱 적분 결과 또는 리더 FK 결과) <-weld(spring)- ee_body(freejoint, 실제 물리 바디,
       tool_rod가 붙어있어 바닥과 충돌하면 반발력이 생김 — mocap_target 자체는 물리 반응 없이
       그냥 쫓아가려고만 하고, weld의 유한 강성이 실제 저항을 만든다).

       tool_rod/floor 충돌 채널(contype/conaffinity=2)과 크기는 so101_new_calib_camera.xml의
       기존 설계를 그대로 가져왔다 (2026-09-23 로봇 몸통 버전에서 검증된 값). -->

  <default>
    <default class="ee">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
  </default>

  <worldbody>
    <body name="mocap_target" mocap="true" pos="0.25 0 0.15">
      <!-- 디버그용 반투명 표식 (목표 위치 확인용, 충돌 없음) -->
      <geom class="ee" type="sphere" size="0.004" rgba="1 1 0 0.35"/>
    </body>

    <body name="ee_body" pos="0.25 0 0.15">
      <freejoint name="ee_free"/>
      <inertial pos="0 0 0" mass="0.05" diaginertia="1e-5 1e-5 1e-5"/>
      <geom class="ee" type="box" size="0.012 0.012 0.008" rgba="0.2 0.2 0.2 1"/>
      <!-- 도구: 얇은 막대, 로컬 -z로 5cm 연장 (so101_new_calib_camera.xml의 검증된 방향/치수 재사용).
           바닥과만 충돌(전용 채널 bit1=2) — ee_body 자신의 표식 박스와는 안 부딪힘(그 박스는 group만
           다르고 contype/conaffinity 0이라 애초에 비충돌). -->
      <geom name="tool_rod" type="cylinder" size="0.0015 0.025" pos="0 0 -0.025"
          rgba="0.55 0.55 0.55 1" contype="2" conaffinity="2" friction="0.3 0.005 0.0001"/>
      <!-- 손목 카메라: 도구 뒤쪽 위에서 도구 끝/작업면을 내려다보는 각도 (근사 배치, 렌더로 확인 필요). -->
      <camera name="wrist" pos="0 0 0.06" euler="0 0 0" fovy="90"/>
    </body>
  </worldbody>

  <equality>
    <!-- solref(time constant, damping ratio): 20ms/critically-damped로 시작 — 부드럽게 목표를
         쫓아가되 바닥 접촉 시 과도한 진동 없이 저항하도록. 불안정하면 첫 값(시간상수)을 늘릴 것. -->
    <weld name="ee_weld" body1="ee_body" body2="mocap_target" solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </equality>
</mujoco>
