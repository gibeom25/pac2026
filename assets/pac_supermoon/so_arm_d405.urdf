    <!-- One driven pinion, two passive racks. The M0.8 / 18T pinion has
         a pitch radius of 0.8 * 18 / 2 = 7.2 mm. With the existing axes,
         positive gripper rotation closes BOTH racks: q_slider = -0.0072*q.
         q=0 is the original open pose. The user-selected closed limit is
         300 degrees = 5.235987755982989 rad, giving 37.699111843 mm
         travel per rack with the same pinion pitch radius.
         These are model coordinates, not calibrated hardware encoder values. -->
    <joint name="gripper" type="revolute">
        <origin xyz="-0.00147463 -9.69429e-19 -9.31736e-19" rpy="1.36523e-15 -2.30137e-15 -3.14159" />
        <axis xyz="-1 0 0" />
        <parent link="pan_head_cross_recess_screw_din_din_en_iso_7045___m3_x_4___z___4n" />
        <child link="rb9_01_062_040_gear_for_gripper_iso___spur_gear_0_8m_18t_20pa_5fw____s18b10h8l6_0s1" />
        <limit effort="10" velocity="10" lower="0" upper="5.235987755982989" />
    </joint>
    <joint name="slider_1" type="prismatic">
        <origin xyz="0.0225 -0.013 -0.002" rpy="0 -1.5708 3.14159" />
        <axis xyz="0 0 1" />
        <parent link="rb9_01_062_010_main_frame_125_follower" />
        <child link="rb9_01_062_030_gear_rack_m0_8" />
        <limit effort="1" velocity="1" lower="-0.03769911184307752" upper="0" />
        <mimic joint="gripper" multiplier="-0.0072" offset="0" />
    </joint>
    <joint name="slider_2" type="prismatic">
        <origin xyz="-0.0225 0.014 -0.002" rpy="0 -1.5708 8.8124e-16" />
        <axis xyz="0 0 1" />
        <parent link="rb9_01_062_010_main_frame_125_follower" />
